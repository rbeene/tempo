{
  "contract_version": 1,
  "types": {
    "uuid": "canonical UUID string",
    "harvest_id": "canonical decimal string, 1..9223372036854775807",
    "counter": "canonical nonnegative decimal string",
    "utc": "RFC3339 UTC timestamp with up to nanosecond precision",
    "timezone": "canonical IANA timezone name",
    "Attribution": {
      "account_id": "harvest_id",
      "user_id": "harvest_id",
      "project_id": "harvest_id",
      "task_id": "harvest_id",
      "timezone": "timezone"
    },
    "ActorKey": {
      "computer_id": "uuid",
      "source": "codex|claude|manual-test",
      "session_id": "string",
      "agent_id": "string"
    },
    "ActorRef": {
      "key": "ActorKey",
      "generation": "counter"
    },
    "ClockSample": {
      "wall_utc": "utc",
      "capability": "available|unavailable",
      "epoch": "string|null",
      "elapsed_ns": "counter|null",
      "awake_ns": "counter|null"
    },
    "Actor": {
      "id": "uuid",
      "revision": "counter",
      "ref": "ActorRef",
      "sequence": "counter",
      "state": "working|wait_user|wait_permission|wait_children|interrupted|finished",
      "health": "continuous|stale|order_blocked",
      "binding_id": "uuid",
      "binding_revision": "counter",
      "attribution": "Attribution",
      "parent": "ActorRef|null",
      "segment_id": "uuid|null",
      "last_evidence": "ClockSample",
      "uncertainty_ids": "uuid[]"
    },
    "Interval": {
      "id": "uuid",
      "computer_id": "uuid",
      "attribution": "Attribution",
      "start": "utc",
      "end": "utc",
      "duration_ns": "counter",
      "segment_ids": "uuid[]"
    },
    "Uncertainty": {
      "id": "uuid",
      "revision": "counter",
      "actor": "ActorRef",
      "segment_id": "uuid",
      "attribution": "Attribution",
      "lower_bound": "utc",
      "upper_bound": "utc|null",
      "reason": "source_lost|ordering_unavailable|suspend|clock_changed|restart_unknown|event_gap|superseded",
      "state": "unresolved|resolved",
      "resolution_end": "utc|null",
      "discarded": "bool"
    },
    "ProjectActivity": {
      "computer_id": "uuid",
      "attribution": "Attribution",
      "active_actor_refs": "ActorRef[]",
      "waiting_actor_refs": "ActorRef[]",
      "provisional_union_ns": "counter",
      "confirmed_closed_ns": "counter",
      "unresolved_ids": "uuid[]",
      "queued_count": "integer",
      "synced_count": "integer",
      "needs_attention_count": "integer"
    },
    "ActivitySnapshot": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "observed_at": "utc",
      "computer_id": "uuid|null",
      "projects": "ProjectActivity[]",
      "actors": "Actor[]",
      "uncertainties": "Uncertainty[]",
      "closed_intervals": "Interval[]",
      "worker": "WorkerStatus",
      "sync_enabled": "bool"
    },
    "WorkerStatus": {
      "state": "not_installed|stopped|running|unsupported|needs_attention",
      "last_success": "utc|null",
      "queued_count": "integer",
      "unknown_count": "integer",
      "failure_category": "string|null",
      "sync_enabled": "bool"
    },
    "Event": {
      "contract_version": "integer=1",
      "actor": "ActorKey",
      "generation": "counter",
      "sequence": "counter",
      "event_id": "string",
      "kind": "work|wait_user|wait_permission|wait_children|interrupt|finish|observe_work",
      "binding_id?": "uuid",
      "binding_revision?": "counter",
      "parent?": "ActorRef",
      "cwd?": "path"
    },
    "EventResult": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "disposition": "applied|duplicate|stale|untracked",
      "actor": "ActorRef",
      "segment_id": "uuid|null",
      "uncertainty_ids": "uuid[]"
    },
    "Binding": {
      "id": "uuid",
      "revision": "counter",
      "kind": "repository|directory",
      "locator": "path",
      "attribution": "Attribution",
      "attached_actors": "ActorRef[]"
    },
    "BindingList": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "bindings": "Binding[]"
    },
    "BindingResult": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "request_id": "uuid",
      "changed": "bool",
      "binding": "Binding"
    },
    "MutationResult": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "request_id": "uuid",
      "changed": "bool",
      "affected_ids": "uuid[]",
      "entity_revision": "counter|null"
    },
    "path": "local filesystem path; canonical absolute path in results",
    "Location": {
      "kind": "repository|directory",
      "locator": "path",
      "root": "path",
      "path": "path"
    }
  },
  "input_limit_bytes": 16384,
  "status_read_only": true,
  "initialization": "First successful explicit link initializes computer identity. Unlinked initial work returns untracked without creating state; bindings resolve locally by Git common-directory or nearest ordinary-directory scope.",
  "actions": [
    {
      "id": "bindings.link",
      "cli": "link [PROJECT_ID]",
      "flags": {
        "task": "harvest_id",
        "path": "path",
        "timezone": "timezone",
        "if-revision": "counter"
      },
      "input": {
        "project_id": "harvest_id",
        "task_id": "harvest_id",
        "path": "path",
        "account_id": "harvest_id",
        "timezone": "timezone",
        "if_revision": "counter"
      },
      "required": [
        "project_id"
      ],
      "result": "BindingResult",
      "effect": "remote_read_local_mutation",
      "ui": "Links; Add/Edit searchable project and task pickers",
      "notes": "Explicit project required; no picker is shipped. Missing task uses a still-active saved choice or sole active task; missing timezone uses a saved choice for this account/project. Unresolved choices return input_required. Path defaults cwd. No user override. Omitted revision means create-only or identical no-op."
    },
    {
      "id": "bindings.list",
      "cli": "links list",
      "flags": {},
      "input": {},
      "required": [],
      "result": "BindingList",
      "effect": "local_read",
      "ui": "Links list"
    },
    {
      "id": "bindings.show",
      "cli": "links show [BINDING_ID]",
      "flags": {
        "path": "path"
      },
      "input": {
        "binding_id": "uuid",
        "path": "path"
      },
      "required": [],
      "result": "BindingList",
      "effect": "local_read",
      "ui": "Link details",
      "notes": "ID and path mutually exclusive; defaults cwd. Exactly one binding returned or not_found."
    },
    {
      "id": "bindings.unlink",
      "cli": "links unlink BINDING_ID",
      "flags": {
        "if-revision": "counter"
      },
      "input": {
        "binding_id": "uuid",
        "if_revision": "counter",
        "confirmed": "bool"
      },
      "required": [
        "binding_id",
        "if_revision",
        "confirmed"
      ],
      "result": "MutationResult",
      "effect": "local_mutation",
      "ui": "Links; Remove with confirmation",
      "notes": "Requires --yes; rejects attached working/waiting/stale generations. Historical snapshots persist."
    },
    {
      "id": "bindings.repair",
      "cli": "links repair BINDING_ID",
      "flags": {
        "path": "path",
        "if-revision": "counter"
      },
      "input": {
        "binding_id": "uuid",
        "path": "path",
        "if_revision": "counter",
        "confirmed": "bool"
      },
      "required": [
        "binding_id",
        "path",
        "if_revision",
        "confirmed"
      ],
      "result": "BindingResult",
      "effect": "local_mutation",
      "ui": "Links; Repair moved repository",
      "notes": "Explicit locator replacement only; same attribution, --yes, no attached generation, no conflicting locator. No remote/name-based guessing."
    }
  ],
  "local_mutation_semantics": "request_id is a UUID; CLI generates one if omitted. Exact replay returns original typed result before config, account, credentials, network or path discovery, after a local durability check. Same request ID with changed explicit intent returns request_conflict. Retry local_write_unknown with the same request ID; safe error details include it. No Harvest writes."
}

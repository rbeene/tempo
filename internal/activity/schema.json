{
  "contract_version": 1,
  "types": {
    "uuid": "canonical UUID string",
    "harvest_id": "canonical decimal string, 1..9223372036854775807",
    "counter": "canonical nonnegative decimal string",
    "utc": "RFC3339 UTC timestamp with up to nanosecond precision",
    "timezone": "canonical IANA timezone name",
    "Attribution": {
      "account_id": "harvest_id",
      "user_id": "harvest_id",
      "project_id": "harvest_id",
      "task_id": "harvest_id",
      "timezone": "timezone"
    },
    "ActorKey": {
      "computer_id": "uuid",
      "source": "codex|claude|manual-test",
      "session_id": "string",
      "agent_id": "string"
    },
    "ActorRef": {
      "key": "ActorKey",
      "generation": "counter"
    },
    "ClockSample": {
      "wall_utc": "utc",
      "capability": "available|unavailable",
      "epoch": "string|null",
      "elapsed_ns": "counter|null",
      "awake_ns": "counter|null"
    },
    "Actor": {
      "id": "uuid",
      "revision": "counter",
      "ref": "ActorRef",
      "sequence": "counter",
      "state": "working|wait_user|wait_permission|wait_children|interrupted|finished",
      "health": "continuous|stale|order_blocked",
      "binding_id": "uuid",
      "binding_revision": "counter",
      "attribution": "Attribution",
      "parent": "ActorRef|null",
      "segment_id": "uuid|null",
      "last_evidence": "ClockSample",
      "uncertainty_ids": "uuid[]"
    },
    "Interval": {
      "id": "uuid",
      "computer_id": "uuid",
      "attribution": "Attribution",
      "start": "utc",
      "end": "utc",
      "duration_ns": "counter",
      "segment_ids": "uuid[]"
    },
    "Uncertainty": {
      "id": "uuid",
      "revision": "counter",
      "actor": "ActorRef",
      "segment_id": "uuid",
      "attribution": "Attribution",
      "lower_bound": "utc",
      "upper_bound": "utc|null",
      "reason": "source_lost|ordering_unavailable|suspend|clock_changed|restart_unknown|event_gap|superseded",
      "state": "unresolved|resolved",
      "resolution_end": "utc|null",
      "discarded": "bool"
    },
    "ProjectActivity": {
      "computer_id": "uuid",
      "attribution": "Attribution",
      "active_actor_refs": "ActorRef[]",
      "waiting_actor_refs": "ActorRef[]",
      "provisional_union_ns": "counter",
      "confirmed_closed_ns": "counter",
      "unresolved_ids": "uuid[]",
      "queued_count": "integer",
      "synced_count": "integer",
      "needs_attention_count": "integer"
    },
    "ActivitySnapshot": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "observed_at": "utc",
      "computer_id": "uuid|null",
      "projects": "ProjectActivity[]",
      "actors": "Actor[]",
      "uncertainties": "Uncertainty[]",
      "closed_intervals": "Interval[]",
      "worker": "WorkerStatus",
      "sync_enabled": "bool"
    },
    "WorkerStatus": {
      "state": "not_installed|stopped|running|unsupported|needs_attention",
      "last_success": "utc|null",
      "queued_count": "integer",
      "unknown_count": "integer",
      "failure_category": "string|null",
      "sync_enabled": "bool"
    },
    "Event": {
      "contract_version": "integer=1",
      "actor": "ActorKey",
      "generation": "counter",
      "sequence": "counter",
      "event_id": "string",
      "kind": "work|wait_user|wait_permission|wait_children|interrupt|finish|observe_work",
      "binding_id?": "uuid",
      "binding_revision?": "counter",
      "parent?": "ActorRef",
      "cwd?": "path"
    },
    "EventResult": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "disposition": "applied|duplicate|stale|untracked",
      "actor": "ActorRef",
      "segment_id": "uuid|null",
      "uncertainty_ids": "uuid[]"
    },
    "Binding": {
      "id": "uuid",
      "revision": "counter",
      "kind": "repository|directory",
      "locator": "path",
      "attribution": "Attribution",
      "attached_actors": "ActorRef[]"
    },
    "BindingList": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "bindings": "Binding[]"
    },
    "BindingResult": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "request_id": "uuid",
      "changed": "bool",
      "binding": "Binding"
    },
    "MutationResult": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "request_id": "uuid",
      "changed": "bool",
      "affected_ids": "uuid[]",
      "entity_revision": "counter|null"
    },
    "path": "local filesystem path; canonical absolute path in results",
    "Location": {
      "kind": "repository|directory",
      "locator": "path",
      "root": "path",
      "path": "path"
    },
    "ReviewList": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "uncertainties": "Uncertainty[]"
    },
    "TimeRange": {
      "start": "utc",
      "end": "utc"
    },
    "RecoveryPreview": {
      "contract_version": "integer=1",
      "snapshot_revision": "counter",
      "uncertainty": "Uncertainty",
      "segment_start": "utc",
      "confirmed_prefix": "TimeRange",
      "proposed_end": "utc",
      "discarded_suffix": "TimeRange|null",
      "affected_union_before": "TimeRange[]",
      "affected_union_after": "TimeRange[]",
      "still_blocked_ids": "uuid[]"
    },
    "reason": "optional user-written recovery rationale; max 512 bytes, no control characters"
  },
  "input_limit_bytes": 16384,
  "status_read_only": true,
  "initialization": "First successful explicit link initializes computer identity. Unlinked initial work returns untracked without creating state; bindings resolve locally by Git common-directory or nearest ordinary-directory scope.",
  "actions": [
    {
      "id": "bindings.link",
      "cli": "link [PROJECT_ID]",
      "flags": {
        "task": "harvest_id",
        "path": "path",
        "timezone": "timezone",
        "if-revision": "counter"
      },
      "input": {
        "project_id": "harvest_id",
        "task_id": "harvest_id",
        "path": "path",
        "account_id": "harvest_id",
        "timezone": "timezone",
        "if_revision": "counter"
      },
      "required": [
        "project_id"
      ],
      "result": "BindingResult",
      "effect": "remote_read_local_mutation",
      "notes": "Explicit project required; no picker is shipped. Missing task uses a still-active saved choice or sole active task; missing timezone uses a saved choice for this account/project. Unresolved choices return input_required. Path defaults cwd. No user override. Omitted revision means create-only or identical no-op."
    },
    {
      "id": "bindings.list",
      "cli": "links list",
      "flags": {},
      "input": {},
      "required": [],
      "result": "BindingList",
      "effect": "local_read"
    },
    {
      "id": "bindings.show",
      "cli": "links show [BINDING_ID]",
      "flags": {
        "path": "path"
      },
      "input": {
        "binding_id": "uuid",
        "path": "path"
      },
      "required": [],
      "result": "BindingList",
      "effect": "local_read",
      "notes": "ID and path mutually exclusive; defaults cwd. Exactly one binding returned or not_found."
    },
    {
      "id": "bindings.unlink",
      "cli": "links unlink BINDING_ID",
      "flags": {
        "if-revision": "counter"
      },
      "input": {
        "binding_id": "uuid",
        "if_revision": "counter",
        "confirmed": "bool"
      },
      "required": [
        "binding_id",
        "if_revision",
        "confirmed"
      ],
      "result": "MutationResult",
      "effect": "local_mutation",
      "notes": "Requires --yes; rejects attached working/waiting/stale generations. Historical snapshots persist."
    },
    {
      "id": "bindings.repair",
      "cli": "links repair BINDING_ID",
      "flags": {
        "path": "path",
        "if-revision": "counter"
      },
      "input": {
        "binding_id": "uuid",
        "path": "path",
        "if_revision": "counter",
        "confirmed": "bool"
      },
      "required": [
        "binding_id",
        "path",
        "if_revision",
        "confirmed"
      ],
      "result": "BindingResult",
      "effect": "local_mutation",
      "notes": "Explicit locator replacement only; same attribution, --yes, no attached generation, no conflicting locator. No remote/name-based guessing."
    },
    {
      "id": "activity.interrupt",
      "cli": "activity interrupt ACTOR_ID",
      "flags": {
        "generation": "counter",
        "if-revision": "counter"
      },
      "input": {
        "actor_id": "uuid",
        "generation": "counter",
        "if_revision": "counter",
        "confirmed": "bool"
      },
      "required": [
        "actor_id",
        "generation",
        "if_revision",
        "confirmed"
      ],
      "result": "MutationResult",
      "effect": "local_mutation",
      "notes": "--yes; detach/tombstone only the targeted generation. Waiting adds no time; working/stale quarantines tail for explicit recovery. Never cascades to children."
    },
    {
      "id": "activity.review",
      "cli": "activity review",
      "flags": {
        "project": "harvest_id"
      },
      "input": {
        "project_id": "harvest_id",
        "account_id": "harvest_id"
      },
      "required": [],
      "result": "ReviewList",
      "effect": "local_read",
      "notes": "Account/project filters do not access credentials."
    },
    {
      "id": "activity.preview",
      "cli": "activity preview UNCERTAINTY_ID",
      "flags": {
        "end": "utc",
        "discard-tail": "bool"
      },
      "input": {
        "uncertainty_id": "uuid",
        "end": "utc",
        "discard_tail": "bool"
      },
      "required": [
        "uncertainty_id"
      ],
      "result": "RecoveryPreview",
      "effect": "local_read",
      "notes": "Exactly one end/discard_tail. Computes bounds, old confirmed prefix, excluded suffix and before/after union through the shared engine. No state or Harvest mutation. Resolve must use returned uncertainty revision; concurrent changes require fresh preview."
    },
    {
      "id": "activity.resolve",
      "cli": "activity resolve UNCERTAINTY_ID",
      "flags": {
        "end": "utc",
        "discard-tail": "bool",
        "if-revision": "counter",
        "reason": "reason"
      },
      "input": {
        "uncertainty_id": "uuid",
        "end": "utc",
        "discard_tail": "bool",
        "if_revision": "counter",
        "reason": "reason",
        "confirmed": "bool"
      },
      "required": [
        "uncertainty_id",
        "if_revision",
        "confirmed"
      ],
      "result": "MutationResult",
      "effect": "local_mutation",
      "notes": "Exactly one of end/discard_tail; --yes. Bounds validated under lock. May finalize safe unions; no Harvest write."
    }
  ],
  "local_mutation_semantics": "request_id is a UUID; CLI generates one if omitted. Exact replay returns original typed result before config, account, credentials, network or path discovery, after a local durability check. Same request ID with changed explicit intent returns request_conflict. Retry local_write_unknown with the same request ID; safe error details include it. No Harvest writes. Recovery observations also keep receipts for no-ops; replay precedes clock sampling. A committed safety quarantine may return a persisted clock error without completing the requested interrupt/resolution; same-ID replay returns the original error. A new request is required for a new reviewed intent.",
  "recovery_semantics": "Review/status/preview are read-only and never access credentials. Preview union ranges include confirmed/resolved time for the affected attribution; open peers remain provisional. Resolve requires exact entity revision and explicit confirmation, preserves original evidence and records an audited end or discarded tail. Discard-tail can use persisted evidence without a working clock. Unresolved tails survive resume/finish/new generations. Explicit interrupt detaches only its generation, preserving working uncertainty; it is not a reliable source lifecycle stop. No Harvest writes."
}

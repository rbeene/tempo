{
  "catalog_version": 1,
  "status": "planned; not emitted by tempo schema until implemented",
  "normative_spec": "agent-contracts.md",
  "envelope_schema_version": 1,
  "type_notation": "Types are named below; T[] is an array, T|null is nullable, enum values use |. Request optional fields may be omitted; result fields are required unless suffixed ?. IDs and counters are strings. No unlisted request fields are accepted. Global output/account flags are CLI options, not secretly injected action inputs.",
  "global_flags": {"json":"bool", "non-interactive":"bool", "account":"harvest_id", "yes":"bool"},
  "local_mutation_flags": {"request-id":"uuid"},
  "local_mutation_semantics": "Each local mutation request also accepts request_id:uuid (generated if absent), persisted with its fingerprint/result. An if_revision is mandatory where listed required. Confirmation is yes in CLI or explicit UI confirmation. Account selection never overrides an existing actor/outbox snapshot.",
  "types": {
    "uuid": "canonical UUID string",
    "harvest_id": "canonical decimal string, 1..9223372036854775807",
    "counter": "canonical nonnegative decimal string",
    "utc": "RFC3339 UTC timestamp with up to nanosecond precision",
    "timezone": "canonical IANA timezone name",
    "path": "absolute or cwd-relative path; canonicalized before binding",
    "reason": "optional user-written recovery rationale; max 512 bytes, no control characters",
    "host": "codex|claude|both",
    "scope": "user|project",
    "theme": "terminal-default|tokyo-night|gruvbox|catppuccin",
    "limit": "integer 1..100, default 20",
    "Attribution": {"account_id":"harvest_id", "user_id":"harvest_id", "project_id":"harvest_id", "task_id":"harvest_id", "timezone":"timezone"},
    "ActorKey": {"computer_id":"uuid", "source":"codex|claude|manual-test", "session_id":"string", "agent_id":"string"},
    "ActorRef": {"key":"ActorKey", "generation":"counter"},
    "Binding": {"id":"uuid", "revision":"counter", "kind":"repository|directory", "locator":"path", "attribution":"Attribution", "attached_actors":"ActorRef[]"},
    "ClockSample": {"wall_utc":"utc", "capability":"available|unavailable", "epoch":"string|null", "elapsed_ns":"counter|null", "awake_ns":"counter|null"},
    "Actor": {"id":"uuid", "revision":"counter", "ref":"ActorRef", "sequence":"counter", "state":"working|wait_user|wait_permission|wait_children|interrupted|finished", "health":"continuous|stale|order_blocked", "binding_id":"uuid", "binding_revision":"counter", "attribution":"Attribution", "parent":"ActorRef|null", "segment_id":"uuid|null", "last_evidence":"ClockSample", "uncertainty_ids":"uuid[]"},
    "Interval": {"id":"uuid", "computer_id":"uuid", "attribution":"Attribution", "start":"utc", "end":"utc", "duration_ns":"counter", "segment_ids":"uuid[]"},
    "Uncertainty": {"id":"uuid", "revision":"counter", "actor":"ActorRef", "segment_id":"uuid", "attribution":"Attribution", "lower_bound":"utc", "upper_bound":"utc|null", "reason":"source_lost|ordering_unavailable|suspend|clock_changed|restart_unknown|event_gap|superseded", "state":"unresolved|resolved", "resolution_end":"utc|null", "discarded":"bool"},
    "ProjectActivity": {"computer_id":"uuid", "attribution":"Attribution", "active_actor_refs":"ActorRef[]", "waiting_actor_refs":"ActorRef[]", "provisional_union_ns":"counter", "confirmed_closed_ns":"counter", "unresolved_ids":"uuid[]", "queued_count":"integer", "synced_count":"integer", "needs_attention_count":"integer"},
    "ActivitySnapshot": {"contract_version":"integer=1", "snapshot_revision":"counter", "observed_at":"utc", "computer_id":"uuid|null", "projects":"ProjectActivity[]", "actors":"Actor[]", "uncertainties":"Uncertainty[]", "closed_intervals":"Interval[]", "worker":"WorkerStatus", "sync_enabled":"bool"},
    "MutationResult": {"contract_version":"integer=1", "snapshot_revision":"counter", "request_id":"uuid", "changed":"bool", "affected_ids":"uuid[]", "entity_revision":"counter|null"},
    "BindingList": {"contract_version":"integer=1", "snapshot_revision":"counter", "bindings":"Binding[]"},
    "BindingResult": {"contract_version":"integer=1", "snapshot_revision":"counter", "request_id":"uuid", "changed":"bool", "binding":"Binding"},
    "TimeRange": {"start":"utc", "end":"utc"},
    "RecoveryPreview": {"contract_version":"integer=1", "snapshot_revision":"counter", "uncertainty":"Uncertainty", "segment_start":"utc", "confirmed_prefix":"TimeRange", "proposed_end":"utc", "discarded_suffix":"TimeRange|null", "affected_union_before":"TimeRange[]", "affected_union_after":"TimeRange[]", "still_blocked_ids":"uuid[]"},
    "ReviewList": {"contract_version":"integer=1", "snapshot_revision":"counter", "uncertainties":"Uncertainty[]"},
    "Event": {"contract_version":"integer=1", "actor":"ActorKey", "generation":"counter", "sequence":"counter", "event_id":"string", "kind":"work|wait_user|wait_permission|wait_children|interrupt|finish|observe_work", "binding_id?":"uuid", "binding_revision?":"counter", "parent?":"ActorRef", "cwd?":"path"},
    "EventResult": {"contract_version":"integer=1", "snapshot_revision":"counter", "disposition":"applied|duplicate|stale|untracked", "actor":"ActorRef", "segment_id":"uuid|null", "uncertainty_ids":"uuid[]"},
    "SetupStatus": {"contract_version":"integer=1", "steps":"SetupStep[]", "complete":"bool"},
    "SetupStep": {"action":"catalog action ID", "state":"ready|input_required|approval_required|unsupported|complete", "required_fields":"string[]", "safe_message":"string"},
    "Diagnostic": {"code":"string", "severity":"info|warning|error", "safe_message":"string", "action":"catalog action ID|null"},
    "Diagnostics": {"contract_version":"integer=1", "items":"Diagnostic[]"},
    "HookStatus": {"host":"codex|claude", "scope":"scope", "path":"path|null", "runtime_version":"string|null", "state":"not_installed|installed|approval_required|awaiting_real_event|receiving|unsupported|needs_repair", "ordering":"supported|review_required|unavailable", "last_real_event":"utc|null", "diagnostics":"Diagnostic[]"},
    "HookList": {"contract_version":"integer=1", "hooks":"HookStatus[]"},
    "HookIntent": {"host":"host", "scope":"scope", "path":"path|null", "operation":"install|repair|uninstall"},
    "HookPreview": {"contract_version":"integer=1", "intent":"HookIntent", "fingerprint":"string", "changes":"HookChange[]", "approval_steps":"string[]"},
    "HookChange": {"host":"codex|claude", "path":"path", "operation":"insert_owned|replace_owned|remove_owned", "safe_summary":"string"},
    "WorkerStatus": {"state":"not_installed|stopped|running|unsupported|needs_attention", "last_success":"utc|null", "queued_count":"integer", "unknown_count":"integer", "failure_category":"string|null", "sync_enabled":"bool"},
    "WorkerResult": {"contract_version":"integer=1", "status":"WorkerStatus"},
    "OutboxItem": {"id":"uuid", "revision":"counter", "interval":"Interval", "state":"queued|submitting|synced|rejected|unknown|needs_attention", "correlation":"string", "entry_id":"harvest_id|null", "failure_category":"string|null"},
    "SyncStatus": {"contract_version":"integer=1", "snapshot_revision":"counter", "enabled":"bool", "items":"OutboxItem[]", "worker":"WorkerStatus"},
    "SyncRun": {"contract_version":"integer=1", "attempted_ids":"uuid[]", "resolved_ids":"uuid[]", "blocked_ids":"uuid[]", "remaining_count":"integer"},
    "ThemeInfo": {"id":"theme", "name":"string", "selected":"bool", "palette":"object of semantic color tokens", "source":"string|null", "license":"string|null"},
    "ThemeList": {"contract_version":"integer=1", "preference_revision":"counter", "themes":"ThemeInfo[]"},
    "ThemeResult": {"contract_version":"integer=1", "preference_revision":"counter", "theme":"ThemeInfo"}
  },
  "actions": [
    {"id":"activity.status", "cli":"activity status", "flags":{"watch":"bool"}, "input":{}, "required":[], "result":"ActivitySnapshot", "effect":"local_read", "ui":"Timers; refresh", "notes":"No credentials/network. watch is interactive only under the terminal mode table; otherwise one snapshot."},
    {"id":"ui.open", "cli":"ui", "flags":{}, "input":{}, "required":[], "result":"ActivitySnapshot", "effect":"presentation", "ui":"Dashboard", "notes":"No-command invocation aliases this mode selection. Forced/redirected mode is activity.status, not a long-running process."},
    {"id":"bindings.link", "cli":"link [PROJECT_ID]", "flags":{"task":"harvest_id", "path":"path", "timezone":"timezone", "if-revision":"counter"}, "input":{"project_id":"harvest_id", "task_id":"harvest_id", "path":"path", "account_id":"harvest_id", "timezone":"timezone", "if_revision":"counter"}, "required":[], "result":"BindingResult", "effect":"remote_read_local_mutation", "ui":"Links; Add/Edit searchable project and task pickers", "notes":"Path defaults cwd. Missing project/task/account/timezone resolved by explicit input, verified saved choice or eligible interactive selection. Noninteractive unresolved choices: input_required. No user override. Omitted revision means create-only or identical no-op."},
    {"id":"bindings.list", "cli":"links list", "flags":{}, "input":{}, "required":[], "result":"BindingList", "effect":"local_read", "ui":"Links list"},
    {"id":"bindings.show", "cli":"links show [BINDING_ID]", "flags":{"path":"path"}, "input":{"binding_id":"uuid", "path":"path"}, "required":[], "result":"BindingList", "effect":"local_read", "ui":"Link details", "notes":"ID and path mutually exclusive; defaults cwd. Exactly one binding returned or not_found."},
    {"id":"bindings.unlink", "cli":"links unlink BINDING_ID", "flags":{"if-revision":"counter"}, "input":{"binding_id":"uuid", "if_revision":"counter", "confirmed":"bool"}, "required":["binding_id","if_revision","confirmed"], "result":"MutationResult", "effect":"local_mutation", "ui":"Links; Remove with confirmation", "notes":"Requires --yes; rejects attached working/waiting/stale generations. Historical snapshots persist."},
    {"id":"bindings.repair", "cli":"links repair BINDING_ID", "flags":{"path":"path", "if-revision":"counter"}, "input":{"binding_id":"uuid", "path":"path", "if_revision":"counter", "confirmed":"bool"}, "required":["binding_id","path","if_revision","confirmed"], "result":"BindingResult", "effect":"local_mutation", "ui":"Links; Repair moved repository", "notes":"Explicit locator replacement only; same attribution, --yes, no attached generation, no conflicting locator. No remote/name-based guessing."},
    {"id":"activity.ingest", "cli":"activity event --input-stdin", "flags":{"input-stdin":"bool"}, "input":{"event":"Event"}, "required":["event"], "result":"EventResult", "effect":"local_event", "ui":"Internal adapter action; status exposes its result", "notes":"Exactly one JSON event <=16 KiB, bounded input/lock/deadline. First work requires resolvable binding_id+binding_revision, cwd, or registered parent. Subsequent events use persisted binding. Unlinked first work yields untracked and no timer."},
    {"id":"activity.interrupt", "cli":"activity interrupt ACTOR_ID", "flags":{"generation":"counter", "if-revision":"counter"}, "input":{"actor_id":"uuid", "generation":"counter", "if_revision":"counter", "confirmed":"bool"}, "required":["actor_id","generation","if_revision","confirmed"], "result":"MutationResult", "effect":"local_mutation", "ui":"Timers; Interrupt stranded actor with confirmation", "notes":"--yes; detach/tombstone only the targeted generation. Waiting adds no time; working/stale quarantines tail for explicit recovery. Never cascades to children."},
    {"id":"hooks.ingest", "cli":"hook HOST --input-stdin", "flags":{"input-stdin":"bool"}, "input":{"host":"codex|claude", "payload":"host-specific allowlisted input"}, "required":["host","payload"], "result":"host-required response", "effect":"local_event", "ui":"Internal hook bridge; diagnostics and registered uncertain ranges visible in Timers", "notes":"Synchronous durable bridge described in agent-contracts.md. Raw host schemas/response are owned by adapter tickets; never retain prompts/transcripts/tool contents. This command is not an arbitrary normalized event generator."},
    {"id":"activity.review", "cli":"activity review", "flags":{"project":"harvest_id"}, "input":{"project_id":"harvest_id", "account_id":"harvest_id"}, "required":[], "result":"ReviewList", "effect":"local_read", "ui":"Timers; Needs review", "notes":"Account/project filters do not access credentials."},
    {"id":"activity.preview", "cli":"activity preview UNCERTAINTY_ID", "flags":{"end":"utc", "discard-tail":"bool"}, "input":{"uncertainty_id":"uuid", "end":"utc", "discard_tail":"bool"}, "required":["uncertainty_id"], "result":"RecoveryPreview", "effect":"local_read", "ui":"Review; Preview proposed resolution", "notes":"Exactly one end/discard_tail. Computes bounds, old confirmed prefix, excluded suffix and before/after union through the shared engine. No state or Harvest mutation. Resolve must use returned uncertainty revision; concurrent changes require fresh preview."},
    {"id":"activity.resolve", "cli":"activity resolve UNCERTAINTY_ID", "flags":{"end":"utc", "discard-tail":"bool", "if-revision":"counter", "reason":"reason"}, "input":{"uncertainty_id":"uuid", "end":"utc", "discard_tail":"bool", "if_revision":"counter", "reason":"reason", "confirmed":"bool"}, "required":["uncertainty_id","if_revision","confirmed"], "result":"MutationResult", "effect":"local_mutation", "ui":"Review actor range; set end or discard tail with confirmation", "notes":"Exactly one of end/discard_tail; --yes. Bounds validated under lock. May finalize safe unions; no Harvest write."},
    {"id":"setup.run", "cli":"setup", "flags":{"host":"host", "scope":"scope", "path":"path"}, "input":{"host":"host", "scope":"scope", "path":"path"}, "required":[], "result":"SetupStatus", "effect":"orchestration", "ui":"Setup", "notes":"Finite readiness result in forced/redirected mode; interactive wizard calls catalog actions separately. No hidden credential grant, hook install or worker install from merely opening setup. Report partial step completion; not a multi-resource atomic transaction."},
    {"id":"doctor.run", "cli":"doctor", "flags":{"check":"bool"}, "input":{"check":"bool"}, "required":[], "result":"Diagnostics", "effect":"local_read_optional_remote_read", "ui":"Setup; Diagnostics", "notes":"Default local only; --check permits bounded credential/server validation. Surface host approval/unsupported ordering/clock, worker and recovery needs."},
    {"id":"hooks.preview", "cli":"hooks preview", "flags":{"host":"host", "scope":"scope", "path":"path", "operation":"install|repair|uninstall"}, "input":{"host":"host", "scope":"scope", "path":"path", "operation":"install|repair|uninstall"}, "required":["host","scope","operation"], "result":"HookPreview", "effect":"local_read", "ui":"Setup; Hooks; Preview", "notes":"Return normalized intent and deterministic SHA-256 fingerprint of intent, current configuration content and Tempo executable/skill version. Project scope requires path, default cwd only for interactive caller. No plan ID, persistence or configuration/identity writes. Preview safe summaries, not raw user settings containing secrets."},
    {"id":"hooks.install", "cli":"hooks install", "flags":{"host":"host", "scope":"scope", "path":"path", "fingerprint":"string"}, "input":{"host":"host", "scope":"scope", "path":"path", "fingerprint":"string", "confirmed":"bool"}, "required":["host","scope","fingerprint","confirmed"], "result":"HookList", "effect":"local_mutation", "ui":"Setup; Hooks; Install approved preview", "notes":"--yes; supply same normalized intent as preview (operation fixed to install), recompute fingerprint under lock, backup, atomic write preserving unrelated hooks. Drift: revision_conflict, preview again. Project scope requires explicit path. Runtime trust/reload remains host-controlled."},
    {"id":"hooks.status", "cli":"hooks status", "flags":{"host":"host", "scope":"scope", "path":"path"}, "input":{"host":"host", "scope":"scope", "path":"path"}, "required":[], "result":"HookList", "effect":"local_read", "ui":"Setup; Hooks; Status"},
    {"id":"hooks.verify", "cli":"hooks verify", "flags":{"host":"host", "scope":"scope", "path":"path"}, "input":{"host":"host", "scope":"scope", "path":"path"}, "required":["host","scope"], "result":"HookList", "effect":"local_read", "ui":"Setup; Hooks; Verify", "notes":"Inspect actual host event receipts, fingerprint and capability; never manufacture receipt by synthetic invocation. No unbounded waiting."},
    {"id":"hooks.repair", "cli":"hooks repair", "flags":{"host":"host", "scope":"scope", "path":"path", "fingerprint":"string"}, "input":{"host":"host", "scope":"scope", "path":"path", "fingerprint":"string", "confirmed":"bool"}, "required":["host","scope","fingerprint","confirmed"], "result":"HookList", "effect":"local_mutation", "ui":"Setup; Hooks; Repair approved preview", "notes":"--yes; same explicit intent/fingerprint/backup/ownership rules as install, operation fixed to repair."},
    {"id":"hooks.uninstall", "cli":"hooks uninstall", "flags":{"host":"host", "scope":"scope", "path":"path", "fingerprint":"string"}, "input":{"host":"host", "scope":"scope", "path":"path", "fingerprint":"string", "confirmed":"bool"}, "required":["host","scope","fingerprint","confirmed"], "result":"HookList", "effect":"local_mutation", "ui":"Setup; Hooks; Remove approved preview", "notes":"--yes; same explicit intent/fingerprint rules as install, operation fixed to uninstall. Remove only Tempo-owned unchanged entries; preserve user edits, unrelated settings and local time."},
    {"id":"worker.install", "cli":"worker install", "flags":{}, "input":{"confirmed":"bool"}, "required":["confirmed"], "result":"WorkerResult", "effect":"local_mutation", "ui":"Setup; Worker; Install", "notes":"--yes; per-user service, normal OS approval, no capture-data deletion. Installation alone does not imply running; use start."},
    {"id":"worker.start", "cli":"worker start", "flags":{}, "input":{}, "required":[], "result":"WorkerResult", "effect":"local_mutation", "ui":"Setup; Worker; Start", "notes":"Single worker per store. No hanging interactive credential prompt."},
    {"id":"worker.status", "cli":"worker status", "flags":{}, "input":{}, "required":[], "result":"WorkerResult", "effect":"local_read", "ui":"Setup; Worker; Status"},
    {"id":"worker.stop", "cli":"worker stop", "flags":{}, "input":{}, "required":[], "result":"WorkerResult", "effect":"local_mutation", "ui":"Setup; Worker; Stop", "notes":"Cancel bounded work and preserve queue/intent. Does not stop capture."},
    {"id":"worker.uninstall", "cli":"worker uninstall", "flags":{}, "input":{"confirmed":"bool"}, "required":["confirmed"], "result":"WorkerResult", "effect":"local_mutation", "ui":"Setup; Worker; Remove", "notes":"--yes; stop then remove Tempo-owned service; preserve store and hooks."},
    {"id":"sync.status", "cli":"sync status", "flags":{}, "input":{}, "required":[], "result":"SyncStatus", "effect":"local_read", "ui":"Timers; Sync queue"},
    {"id":"sync.now", "cli":"sync now", "flags":{"limit":"limit"}, "input":{"limit":"limit"}, "required":[], "result":"SyncRun", "effect":"remote_mutation", "ui":"Sync; Run eligible queued work", "notes":"Bounded pass using durable claims; cannot replay unknown/submitting/rejected items. Disabled syncing requires sync.resume first. Per-item failures persist; overall result identifies blocked items."},
    {"id":"sync.reconcile", "cli":"sync reconcile [OUTBOX_ID]", "flags":{"limit":"limit"}, "input":{"outbox_id":"uuid", "limit":"limit"}, "required":[], "result":"SyncRun", "effect":"remote_read_local_mutation", "ui":"Sync; Reconcile uncertain submissions", "notes":"Read-only Harvest matching; no POST/PATCH/DELETE."},
    {"id":"sync.resolve", "cli":"sync resolve OUTBOX_ID", "flags":{"entry":"harvest_id", "retry-rejected":"bool", "if-revision":"counter"}, "input":{"outbox_id":"uuid", "entry_id":"harvest_id", "retry_rejected":"bool", "if_revision":"counter", "confirmed":"bool"}, "required":["outbox_id","if_revision","confirmed"], "result":"MutationResult", "effect":"remote_read_local_mutation", "ui":"Sync; Review match or confirmed rejection", "notes":"--yes; exactly one entry_id/retry_rejected. Entry must match immutable owned interval. Retry allowed only from conclusive rejected, queues a new recorded attempt. No retry-unknown escape hatch."},
    {"id":"sync.pause", "cli":"sync pause", "flags":{}, "input":{}, "required":[], "result":"MutationResult", "effect":"local_mutation", "ui":"Setup; Pause synchronization", "notes":"Stop future claims; already submitting may finish or become unknown. Capture continues."},
    {"id":"sync.resume", "cli":"sync resume", "flags":{}, "input":{}, "required":[], "result":"MutationResult", "effect":"local_mutation", "ui":"Setup; Resume synchronization", "notes":"Wake worker; never authorizes replay of an ambiguous mutation."},
    {"id":"themes.list", "cli":"themes list", "flags":{}, "input":{}, "required":[], "result":"ThemeList", "effect":"local_read", "ui":"Setup; Appearance; Theme picker"},
    {"id":"themes.show", "cli":"themes show [THEME]", "flags":{}, "input":{"theme":"theme"}, "required":[], "result":"ThemeResult", "effect":"local_read", "ui":"Appearance; Preview without saving", "notes":"Default selected theme. Preview cancellation leaves persisted preference unchanged."},
    {"id":"themes.set", "cli":"themes set THEME", "flags":{"if-revision":"counter"}, "input":{"theme":"theme", "if_revision":"counter"}, "required":["theme"], "result":"MutationResult", "effect":"local_mutation", "ui":"Appearance; Apply", "notes":"UI supplies preference revision; CLI may use last-writer preference semantics when revision omitted. Never change timing or terminal-emulator settings. JSON stays uncolored; respect NO_COLOR."},
    {"id":"themes.reset", "cli":"themes reset", "flags":{"if-revision":"counter"}, "input":{"if_revision":"counter"}, "required":[], "result":"MutationResult", "effect":"local_mutation", "ui":"Appearance; Terminal default", "notes":"Equivalent to themes.set terminal-default."}
  ],
  "existing_actions": [
    {"id":"auth.login", "cli":"auth login --token-stdin [--account ID]", "ui":"Setup; Connect with secure secret input", "contract":"cli-schema.json; UI feeds token directly to the same auth operation, never an argument"},
    {"id":"auth.status", "cli":"auth status [--check]", "ui":"Setup; Authentication status", "contract":"cli-schema.json; may access secure store; never called implicitly by local timer status"},
    {"id":"auth.logout", "cli":"auth logout --yes", "ui":"Setup; Disconnect with confirmation", "contract":"cli-schema.json; preserve activity/bindings/outbox and their historical attribution"},
    {"id":"accounts.list", "cli":"accounts list", "ui":"Setup; Account picker", "contract":"cli-schema.json"},
    {"id":"accounts.use", "cli":"accounts use ID", "ui":"Setup; Select account", "contract":"cli-schema.json; default selection does not rebind existing activity"},
    {"id":"projects.list", "cli":"projects list", "ui":"Links; Active assigned project picker", "contract":"cli-schema.json; filter active assignments, no admin catalog requirement"},
    {"id":"tasks.list", "cli":"tasks list --project ID", "ui":"Links; Active assigned task picker", "contract":"cli-schema.json"},
    {"id":"config.show", "cli":"config show", "ui":"Setup; Nonsecret configuration", "contract":"cli-schema.json"}
  ]
}
